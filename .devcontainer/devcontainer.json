{
  "name": "ioc-checker",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e '.[dev]' && pytest -q",
  "postAttachCommand": "echo 'Try it (no API keys needed):  ioc-checker --demo' ",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": { "python.testing.pytestEnabled": true }
    }
  }
}
